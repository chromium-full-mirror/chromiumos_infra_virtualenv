# Run turtle graphics inside virtualenv.
#
# This script is a canonical template that can be copied to other
# repositories.
set -eu

original=$(pwd)
cd -- "$(readlink -e -- "$(dirname -- "$0")")"
. ./find_virtualenv.sh
cd -- "$original"

exec_python_module turtle "$@"
